---
import { Image } from "astro:assets";

import CardServicios from "../components/CardServicios.astro";
import Layout from "../layouts/Layout.astro";

import Bordado from "../assets/img/bordado.png";
import Sublimado from "../assets/img/sublimado.png";
import Publicidad from "../assets/img/publicidad.png";
import Politica from "../assets/img/politica.png";
import Services from "../assets/img/Servicios.png";
import Moda from "../assets/img/moda.jpg";
import Portada from "../assets/img/portdada-1.jpg";
---

<Layout>
  <section class="w-full px-6 py-16 md:py-24">
    <div
      class="max-w-4xl mx-auto bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-6 md:p-10  text-center shadow-xl"
    >
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-semibold leading-tight">
        Servicios de Confección de camisetas personalizadas
      </h1>

      <p class="mt-5 text-base md:text-lg text-gray-300 max-w-2xl mx-auto">
        Ofrecemos una amplia gama de servicios de confección de camisetas. Desde
        diseños personalizados hasta producción en masa, adaptamos nuestras
        soluciones a tus necesidades.
      </p>
    </div>
  </section>

  <section class="w-full px-6 pb-16">
    <div
      class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-10"
    >
      <CardServicios src={Bordado} alt="Bordado" title="Bordados" />

      <CardServicios src={Sublimado} alt="Sublimados" title="Sublimados" />

      <CardServicios src={Publicidad} alt="Publicidad" title="Publicidad" />

      <CardServicios src={Politica} alt="Política" title="Política" />
    </div>
  </section>

  <section class="max-w-6xl mx-auto mt-20 px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 rounded-2xl overflow-hidden shadow-xl">
      <!-- IZQUIERDA -->
      <div class="relative bg-[#fef0df] p-8">
        <Image
          src={Services}
          alt="Servicios"
          class="w-full h-100 object-contain"
        />

        <div
          class="absolute bottom-4 left-4 right-4 bg-blue-500/90 backdrop-blur-sm p-5 rounded-xl"
        >
          <h2 class="text-2xl  font-bold mb-2">
            Camisetas con Diseños
          </h2>
          <p class="text-sm text-gray-200">
            Expresa la personalidad de tu marca y llévala al siguiente nivel con
            nuestras camisetas personalizadas.
          </p>
        </div>
      </div>

      <!-- DERECHA -->
      <div class="bg-[#ff5038] p-6 flex flex-col justify-center gap-8 items-center">
        <!-- ITEM 1 -->
        <div class="flex items-center gap-8">
          <div class="">
            <h2 class="font-bold text-2xl mb-2">Calidad y Estilo</h2>
            <ul class="text-sm space-y-1">
              <li>100% algodón y mezcla</li>
              <li>70% compacto</li>
              <li>50% semi-compacto</li>
              <li>30% jersy</li>
              <li>10% poliéster</li>
              <li>Camisetas tipo polo</li>
            </ul>
          </div>

          <div>
            <Image
              src={Portada}
              alt="Portada"
              class="h-40 w-40 object-cover rounded-xl"
            />
          </div>
        </div>

        <!-- ITEM 2 -->
        <div class="flex items-center gap-8">
          <Image
            src={Moda}
            alt="Moda"
            class="h-40 w-40 object-cover rounded-xl"
          />

          <div class="">
            <h2 class="font-bold text-2xl mb-2">Encuentra tu fit</h2>
            <ul class="text-sm space-y-1 /90">
              <li>Variedad de tallas y estilos</li>
              <li>Unisex y oversized</li>
              <li>Impresión de estampas</li>
              <li>Duraderas y colores vibrantes</li>
              <li>Camisetas tipo polo</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
