---
import Layout from "../layouts/Layout.astro";
import images from '../data/images.json';
import { Image } from "astro:assets";
---

<Layout>
  <section class="max-w-6xl mx-auto px-4 mt-20">

    <h1 class="text-4xl font-bold text-center mb-10 text-white">
      Galería
    </h1>

    <!-- Pinterest Layout -->
    <div class="columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4">
      {images.map((img) => (
        <div class="overflow-hidden rounded-xl group cursor-pointer">
          <Image 
            src={img.src} 
            alt="camiseta"
            width={500}
            height={500}
            loading='eager'
            class="w-full rounded-xl transition-transform duration-300 group-hover:scale-105"
          />
        </div>
      ))}
    </div>

  </section>
</Layout>