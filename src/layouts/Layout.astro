---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Carola-Tex</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 20% 30%, rgba(59, 130, 246, 0.6), transparent 40%),
      radial-gradient(circle at 80% 20%, rgba(96, 165, 250, 0.5), transparent 40%),
      radial-gradient(circle at 50% 80%, rgba(37, 99, 235, 0.5), transparent 50%),
      #020617;
  }
</style>