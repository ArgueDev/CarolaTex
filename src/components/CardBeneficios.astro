---
interface Props {
  icon: any;
  size?: number;
  color?: string;
  title: string;
  description: string;
}

const { icon: Icon, size = 40, color = "#3e9392", title, description } = Astro.props;
---

<div class="flex flex-col items-center">
  <Icon size={size} color={color} />
  <h2 class="text-2xl mt-4 mb-2 font-semibold text-white">
    {title}
  </h2>
  <p class="text-gray-300 text-xl">
    {description}
  </p>
</div>
