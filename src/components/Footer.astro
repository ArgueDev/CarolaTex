---
const date = new Date().getFullYear();
---

<footer class="text-black bg-gray-200">
    <div class="flex md:flex-row flex-col md:items-start items-center justify-around md:mt-50 mt-20 p-8">
        <img src="/img/logo_nav.png" alt="logo">
        <div class="flex flex-col gap-4 md:mt-10 mt-8">
            <h2 class="font-semibold text-xl">Contáctanos</h2>
            <a href="/nosotros" class="text-sm text-gray-500 hover:font-semibold">Sobre Nosotros</a>
            <a href="/servicios" class="text-sm text-gray-500 hover:font-semibold">Servicios</a>
            <a href="/galeria" class="text-sm text-gray-500 hover:font-semibold">Galería</a>
            <a href="" class="text-sm text-gray-500 hover:font-semibold">Cotiza Ahora</a>
        </div>
        <div class="flex flex-col gap-4 md:mt-10 mt-8">
            <h2 class="font-semibold text-xl">Siguenos</h2>
            <a href="https://www.facebook.com/technologytetil/" target="_blank" class="text-sm text-gray-500 hover:font-semibold">Facebook</a>
