---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src: ImageMetadata;
    alt: string;
    title: string;
}

const { src, alt, title } = Astro.props;
---

<div class="flex flex-col items-center bg-gray-300 py-5 rounded-2xl shadow-white hover:scale-105 transition-transform duration-300">
    <Image src={src} alt={alt} class='h-48 w-full object-contain' loading='eager' priority/>
    <h2 class="text-blue-950 text-4xl font-semibold mt-4">{title}</h2>
</div>